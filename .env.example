# Server Configuration
PORT=3000

# Meta Webhook Verification Token (Choose any secret string, e.g. my_secret_token_123)
META_VERIFY_TOKEN=meta_secret_lead_token_2026

# Meta Page Access Token (Generated from Graph API Explorer with leads_retrieval & pages_manage_metadata)
META_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Meta Graph API Version
META_GRAPH_VERSION=v21.0

# Meta Lead Form ID (Optional: Enter your form ID to enable hybrid polling reconciliation)
META_FORM_ID=your_lead_form_id_here
